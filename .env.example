# Copy to .env and fill in. NEVER commit .env — it is git-ignored; keep it that way.
# Your team's LLM API key is in your team's NTULearn item (released at the Mon 16 Nov briefing, which is on Zoom).
OPENAI_API_KEY=

# Copilot model and bounded context settings
KAYA_OPENAI_MODEL=gpt-4o-mini
KAYA_LLM_TEMPERATURE=0
KAYA_LLM_TIMEOUT_SECONDS=30
KAYA_LLM_MAX_RETRIES=2
KAYA_LLM_MAX_OUTPUT_TOKENS=1000
KAYA_LLM_INPUT_TOKEN_BUDGET=12000
KAYA_AGENT_MAX_STEPS=8
KAYA_TOOL_MAX_RESULT_BYTES=30000

# MySQL container and application connection settings
KAYA_DB_HOST=mysql
KAYA_DB_PORT=3306
KAYA_DB_NAME=kayakopi
KAYA_DB_USER=kaya_app
KAYA_DB_PASSWORD=change-me
KAYA_DB_ROOT_PASSWORD=change-root-password

# Host ports. Change these when the defaults are already in use.
KAYA_DB_HOST_PORT=3306
KAYA_STREAMLIT_HOST_PORT=8501
